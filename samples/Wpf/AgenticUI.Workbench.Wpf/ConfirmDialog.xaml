<Window x:Class="AgenticUI.Workbench.Wpf.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:agentic="clr-namespace:AgenticUI.Wpf;assembly=AgenticUI.Wpf"
        Title="确认操作"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <AdornerDecorator>
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="这是正常的模态确认弹窗。&#x0a;弹窗打开后请在远程端刷新列表，即可 click「确定」或「取消」。"
                 TextWrapping="Wrap"
                 FontSize="14"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0">
        <agentic:AgenticButton x:Name="OkButton"
                               AgenticId="dialog.ok"
                               AgenticDisplayName="确认弹窗-确定"
                               InstructionNumber="10"
                               Hint="确认并关闭弹窗"
                               Content="确定"
                               Width="100"
                               Height="36"
                               Margin="0,0,12,0"
                               IsDefault="True"
                               Click="OkButton_OnClick" />
        <agentic:AgenticButton x:Name="CancelButton"
                               AgenticId="dialog.cancel"
                               AgenticDisplayName="确认弹窗-取消"
                               InstructionNumber="11"
                               Hint="取消并关闭弹窗"
                               Content="取消"
                               Width="100"
                               Height="36"
                               IsCancel="True"
                               Click="CancelButton_OnClick" />
      </StackPanel>
    </Grid>
  </AdornerDecorator>
</Window>
