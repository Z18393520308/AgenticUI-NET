{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:7443"
      }
    }
  },
  "AgenticUI": {
    "PipeName": "AgenticUI.NET",
    "AuthenticationToken": "",
    "LocalAuthenticationToken": "",
    "WebSocketPath": "/agenticui",
    "MaximumMessageLength": 1048576,
    "NamedPipeConnectTimeoutMilliseconds": 5000,
    "MaxConnections": 32,
    "ConnectionAttemptsPerMinute": 30,
    "RequestsPerMinute": 120,
    "KeepAliveSeconds": 30,
    "AllowedOrigins": [],
    "AllowedActions": [
      "focus",
      "highlight",
      "clearHighlight",
      "getText",
      "getValue",
      "getChecked",
      "getRow",
      "getRows",
      "getColumns",
      "getCell",
      "scrollToRow",
      "highlightCell",
      "selectCell"
    ],
    "Discovery": {
      "Enabled": false,
      "Port": 47731,
      "IntervalSeconds": 5,
      "ServiceName": "AgenticUI Gateway",
      "PublicWebSocketUrl": "wss://localhost:7443/agenticui",
      "InstanceId": ""
    }
  }
}
